---
import Base from '../layouts/Base.astro';
import EarlyAccessForm from '../components/EarlyAccessForm.astro';

const site = 'https://epicworks.cz';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#org`,
      name: 'Epicworks s.r.o.',
      url: `${site}/`,
      logo: `${site}/logo-ew.png`,
      email: 'scan@epicworks.cz',
      identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: '05909104' },
      address: { '@type': 'PostalAddress', addressCountry: 'CZ' },
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'EpicScan',
      url: `${site}/`,
      inLanguage: 'en',
      publisher: { '@id': `${site}/#org` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#epicscan`,
      name: 'EpicScan',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Security scanner',
      operatingSystem: 'Any (Python 3.8 or newer)',
      description: 'Budget-capped AI security scans for pull and merge requests, built on the open-source nano-analyzer.',
      url: `${site}/`,
      publisher: { '@id': `${site}/#org` },
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
    },
  ],
};
---
<Base
  title="EpicScan: pay-per-scan AI security review for pull requests"
  description="Set a budget and a deadline in your pull or merge request comment. EpicScan fits the security scan to it and charges only what the scan cost."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="pill"><span class="pill-dot" aria-hidden="true"></span>Early access · No subscriptions · Pay per scan</p>
      <h1 class="h1">Budget-driven code security.<span class="grad">Set your price in the PR. We fit the audit to it.</span></h1>
      <p class="lead">No seats and no monthly plan. Comment <code class="cmd">@epicscan €0.50 --max-delay 5m</code> on a pull or merge request, and EpicScan plans how deep to scan so it fits your cap and your deadline. You pay only what the scan actually cost.</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-glow" href="/early-access">Request early access</a>
        <a class="btn btn-secondary" href="/how-it-works#syntax">See the command syntax</a>
      </div>
      <p class="notice"><strong>Early access, still in development.</strong> The open-source scanner runs today from the command line and from your own CI. The GitLab merge-request job and the GitHub Action are in private testing. The <code>@epicscan</code> comment command, budget and deadline caps, and prepaid credits are what we are building next. Nothing can be bought yet, and every example and number on this page is illustrative. Questions? Email <a href="mailto:scan@epicworks.cz">scan@epicworks.cz</a>.</p>
    </div>
  </section>

  <section style="padding: 24px 0 96px;" aria-labelledby="demo-title">
    <div class="container narrow stack" style="--gap: 14px;">
      <h2 id="demo-title" class="sr-only">Example of an EpicScan report</h2>
      <p style="text-align: center; font-size: 13px; font-style: italic; color: #f5b94a;">Illustrative example: mock output showing the intended flow, not a real scan result.</p>
      <div class="demo">
        <div class="demo-bar">
          <div class="demo-dots" aria-hidden="true"><span style="background:#f87171"></span><span style="background:#fbbf24"></span><span style="background:#34d399"></span></div>
          <span class="demo-title">Merge request !418 · @epicscan €0.50 --max-delay 5m</span>
          <span class="status status-example" style="align-self:center;">Example</span>
        </div>
        <div class="demo-body">
          <div class="demo-comment">
            <span class="user-chip">reviewer-jane</span>
            <span>Looking at the C++ changes. <span class="mono" style="color: var(--sky); font-weight: 500;">@epicscan €0.50 --max-delay 5m</span></span>
          </div>
          <span class="muted" style="font-size: 14px;">EpicScan Bot (example)</span>
          <div class="finding">
            <div style="display: flex; gap: 14px; align-items: flex-start;">
              <span class="icon-tile" style="background: rgba(248,113,113,0.14); color: var(--red); width: 38px; height: 38px;" aria-hidden="true"><svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></span>
              <div>
                <p style="font-size: 17px; font-weight: 700; color: var(--text-strong);">Use-after-free in <span class="mono" style="color: var(--sky); font-weight: 500;">interpreter.cpp:142</span></p>
                <p class="muted" style="font-size: 14px;">Severity: High · Cap: €0.50 · Max delay: 5 min</p>
              </div>
            </div>
            <div style="border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; background: var(--surface);">
              <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 8px;">
                <span style="font-size: 14px; font-weight: 600; color: var(--indigo-soft);">Scan and credit summary</span>
                <span class="mono" style="font-size: 13px; color: var(--amber); background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.30); padding: 3px 10px; border-radius: 6px;">€0.161 of €0.50 cap</span>
              </div>
              <div class="scroll-x">
                <table class="cost-table">
                  <thead><tr><th scope="col">Step</th><th scope="col">Detail</th><th scope="col">Cost</th><th scope="col">Status</th></tr></thead>
                  <tbody>
                    <tr><td>Context and scan</td><td class="mono muted" style="font-size:12px;">Changed files</td><td class="mono" style="color: var(--sky);">€0.041</td><td style="color: var(--green);">Within cap</td></tr>
                    <tr><td>Skeptical triage</td><td class="mono muted" style="font-size:12px;">5 rounds</td><td class="mono" style="color: var(--sky);">€0.120</td><td style="color: var(--green);">Completed</td></tr>
                    <tr><td style="background: rgba(148,163,184,0.06);">Credit deducted</td><td class="mono muted" style="font-size:12px; background: rgba(148,163,184,0.06);">Prepaid pool</td><td class="mono" style="color: var(--sky); background: rgba(148,163,184,0.06);">−€0.161</td><td class="muted" style="font-weight: 400; background: rgba(148,163,184,0.06);">Remaining: €248.34</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="command" class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="status status-roadmap" style="align-self: center;">Roadmap: the comment command is in development.</span>
        <h2 class="h2">Control every scan from the comment thread</h2>
        <p>Developers, reviewers and project leads set the budget and the deadline where the review already happens.</p>
      </div>
      <div class="grid" style="--min: 300px; gap: 24px;">
        <article class="card">
          <span class="eyebrow" style="color: var(--teal);">Quick check</span>
          <code class="cmd-block" style="color: var(--teal);">@epicscan €0.25</code>
          <h3>Lightweight sanity scan</h3>
          <p>For everyday changes. EpicScan scans the changed files with one fast pass.</p>
          <p class="card-foot">Real per-scan costs: <strong>published after benchmarks</strong></p>
        </article>
        <article class="card card-highlight">
          <span class="eyebrow" style="color: var(--indigo-soft);">Recommended</span>
          <code class="cmd-block" style="color: var(--indigo-soft);">@epicscan €0.50 --max-delay 5m</code>
          <h3>Deep scan with a deadline</h3>
          <p>For release candidates. Aims to finish within 5 minutes and spends up to €0.50 on deeper context, scanning and multi-round triage. If time runs out, you get a partial report instead of a stuck pipeline.</p>
          <p class="card-foot">Real per-scan costs: <strong>published after benchmarks</strong></p>
        </article>
        <article class="card">
          <span class="eyebrow" style="color: #7dd3fc;">Critical change</span>
          <code class="cmd-block" style="color: #7dd3fc;">@epicscan €5.00 --depth deep</code>
          <h3>The deepest scan your budget allows</h3>
          <p>For core or security-sensitive code. Spends the larger cap on wider context and more triage rounds; the report lists exactly what was covered.</p>
          <p class="card-foot">Real per-scan costs: <strong>published after benchmarks</strong></p>
        </article>
      </div>
      <p style="text-align: center; margin-top: 40px; color: var(--text-body);">New here? <a href="/how-it-works">Read how it works</a>.</p>
    </div>
  </section>

  <section id="features" class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h2">Pay per scan, not per seat</h2>
        <p>No idle seats. You pay for the scans that actually run.</p>
      </div>
      <div class="grid" style="--min: 320px;">
        <article class="card" style="border-color: rgba(99,102,241,0.55);">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="icon-tile" style="background: rgba(94,234,212,0.12); color: var(--teal);" aria-hidden="true"><svg viewBox="0 0 24 24"><line x1="12" y1="2" x2="12" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></span>
            <span class="badge-grad">ZERO WASTE</span>
          </div>
          <h3>Charged only when a scan runs</h3>
          <span class="status status-roadmap">Roadmap</span>
          <p>No licences for developers who rarely open a pull request. Credit is deducted only when a scan runs, based on what it actually cost. If a scan fails, nothing is charged.</p>
        </article>
        <article class="card">
          <span class="icon-tile" style="background: rgba(129,140,248,0.12); color: var(--indigo-soft);" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"></rect><rect x="2" y="14" width="20" height="8" rx="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg></span>
          <h3>Our hardware, or yours</h3>
          <span class="status status-testing">In testing</span>
          <p>Hosted scans run on our own Mac Studio machines in the Czech Republic. Prefer your own setup? Point the scanner at your own model endpoint. Your code goes only where you choose. <a href="/privacy-and-data">Where does my code go?</a></p>
        </article>
        <article class="card">
          <span class="icon-tile" style="background: rgba(52,211,153,0.12); color: var(--green);" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></span>
          <h3>Deadline-aware scans</h3>
          <span class="status status-roadmap">Roadmap</span>
          <p>With <code class="mono" style="color: var(--indigo-soft); font-size: 13px;">--max-delay 5m</code>, EpicScan will not hold up your pipeline. As the deadline nears, it stops starting new work and posts a partial report of what it covered.</p>
        </article>
        <article class="card">
          <span class="icon-tile" style="background: rgba(251,191,36,0.12); color: #fbbf24;" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg></span>
          <h3>Skips unchanged files</h3>
          <span class="status status-roadmap">Roadmap</span>
          <p>Re-scans will skip files that have not changed, so you never pay twice for the same code.</p>
        </article>
        <article class="card">
          <span class="icon-tile" style="background: rgba(248,113,113,0.12); color: var(--red);" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M13 6h3a2 2 0 0 1 2 2v7"></path><line x1="6" y1="9" x2="6" y2="21"></line></svg></span>
          <h3>Built for GitHub and GitLab</h3>
          <span class="status status-live">Live · CLI in your CI</span>
          <p>Run the open-source scanner from any CI job today. A GitLab merge-request job and a GitHub Action are in private testing. The <code class="mono" style="color: var(--indigo-soft); font-size: 13px;">@epicscan</code> comment trigger comes next.</p>
        </article>
        <article class="card">
          <span class="icon-tile" style="background: rgba(125,211,252,0.12); color: #7dd3fc;" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg></span>
          <h3>Simple prepaid credits</h3>
          <span class="status status-roadmap">Roadmap</span>
          <p>Top up a prepaid balance, and each scan deducts only its actual cost. Team-level budget caps may follow.</p>
        </article>
      </div>
      <p class="notice" style="max-width: 820px; margin: 48px auto 0; text-align: center;"><strong>A note on accuracy.</strong> AI scanners can flag issues that turn out to be harmless (false positives) and can miss real ones (false negatives). The engine is tuned for C and C++ memory-safety bugs and is less effective in other languages. Findings of medium severity and above go through five rounds of skeptical triage before they reach you. Treat results as strong leads for a human reviewer, not as verdicts.</p>
    </div>
  </section>

  <section id="code" class="section section-alt">
    <div class="container" style="max-width: 1148px;">
      <div class="section-head">
        <h2 class="h2">Where does my code go?</h2>
        <p>Only where you choose. Hosted scans run on our own Mac Studio machines in the Czech Republic, and your code is not kept after the scan. Self-hosted scans never leave your network.</p>
      </div>
      <div class="grid" style="--min: 280px;">
        <article class="card">
          <span class="icon-tile" style="background: rgba(129,140,248,0.12); color: var(--indigo-soft);" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"></rect><rect x="2" y="14" width="20" height="8" rx="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg></span>
          <h3>Our own hardware</h3>
          <p>Mac Studio machines owned and operated by Epicworks s.r.o. in the Czech Republic. No third-party AI service sees your code.</p>
        </article>
        <article class="card">
          <span class="icon-tile" style="background: rgba(52,211,153,0.12); color: var(--green);" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></span>
          <h3>Not kept after the scan</h3>
          <p>Your code is deleted when the scan ends and never used to train models. Request logs are kept for up to 30 days.</p>
        </article>
        <article class="card">
          <span class="icon-tile" style="background: rgba(251,191,36,0.12); color: #fbbf24;" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
          <h3>Or keep it on-prem</h3>
          <p>The scanner is open source (Apache-2.0). Run it on your own machines and your code never leaves your network.</p>
        </article>
      </div>
      <p style="text-align: center; margin-top: 40px;"><a href="/privacy-and-data">Read the details</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 1148px;">
      <div class="section-head">
        <h2 class="h2">Simple prepaid credit packs</h2>
        <p>Draft early-access prices. Nothing can be bought yet.</p>
      </div>
      <div class="grid" style="--min: 260px;">
        <div class="card" style="gap: 6px;"><h3>Developer Starter</h3><p class="price">€25</p><p class="muted">prepaid credit</p></div>
        <div class="card card-highlight" style="gap: 6px;"><div style="display:flex;justify-content:space-between;align-items:center;gap:8px;"><h3>Team Shared Pool</h3><span class="badge-grad">Recommended</span></div><p class="price">€250</p><p class="muted">prepaid credit</p></div>
        <div class="card" style="gap: 6px;"><h3>Enterprise / Self-hosted</h3><p class="price">Custom</p><p class="muted">your infrastructure</p></div>
      </div>
      <p style="text-align: center; margin-top: 40px;"><a href="/pricing">See full pricing</a></p>
    </div>
  </section>

  <section id="early-access" class="section section-alt" style="background: radial-gradient(640px circle at 20% 50%, rgba(79,70,229,0.14), transparent 70%);">
    <div class="container" style="max-width: 1148px;">
      <div class="panel split">
        <div class="stack">
          <h2 class="h2">Get early access</h2>
          <p class="lead" style="font-size: 17px;">Tell us where your code lives. We will email you when EpicScan is ready for your platform. No newsletter, no tracking.</p>
        </div>
        <EarlyAccessForm id="ea-home" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 868px;">
      <h2 class="h2" style="text-align: center; margin-bottom: 32px;">Questions</h2>
      <div class="faq">
        <details open><summary>Is EpicScan available now?</summary><p>The open-source scanner is, and you can run it today. Hosted scans, the comment command and credits are in development. Join early access to try them first.</p></details>
        <details><summary>Which languages work best?</summary><p>C and C++ today. The engine was built to find memory-safety bugs such as buffer overflows and use-after-free. Other languages work, but with weaker results.</p></details>
        <details><summary>Does it replace a security audit?</summary><p>No. EpicScan finds strong leads quickly and cheaply. A human still decides what is real.</p></details>
        <details><summary>What will a scan cost?</summary><p>You set the cap, and a scan never costs more than that. Typical costs per scan will be published after benchmarks.</p></details>
        <details><summary>Can I run it on my own hardware?</summary><p>Yes. The scanner is open source under Apache-2.0. Self-hosted support with your own model endpoint is in testing.</p></details>
        <details><summary>Who is behind EpicScan?</summary><p>Epicworks s.r.o., a Czech company. EpicScan is built on nano-analyzer, the open-source scanner by AISLE, and is not affiliated with AISLE.</p></details>
      </div>
    </div>
  </section>
</Base>
