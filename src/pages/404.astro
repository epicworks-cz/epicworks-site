---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · EpicScan" description="This page does not exist." path="/404" noindex>
  <section class="page-hero" style="padding-bottom: 120px;">
    <div class="container hero-inner" style="gap: 20px;">
      <h1 class="h1">This page does not exist.</h1>
      <p class="lead">It may have moved when we rebuilt the site.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Back to the home page</a>
        <a class="btn btn-secondary" href="/early-access">Request early access</a>
      </div>
    </div>
  </section>
</Base>
