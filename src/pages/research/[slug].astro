---
import Base from '../../layouts/Base.astro';
import { apps, type App, type Run } from '../../data/wider-benchmark';

export function getStaticPaths() {
  return apps.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: App };
const sum = (rs: Run[], k: keyof Run) => rs.reduce((n, r) => n + Number(r[k]), 0);
const found = a.vulnerable.filter((r) => r.found).length;
const keptV = sum(a.vulnerable, 'kept');
const keptP = sum(a.patched, 'kept');
const rejected = sum(a.vulnerable, 'rejected') + sum(a.patched, 'rejected');
const confirmedOther = sum(a.vulnerable, 'confirmed') - found + sum(a.patched, 'confirmed');
const label = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const cell = (r: Run) => `${r.candidates} raised, ${r.kept} kept; Opus: ${r.confirmed} confirmed, ${r.uncertain} uncertain, ${r.rejected} rejected`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'TechArticle', headline: a.headline, datePublished: a.published,
  author: { '@type': 'Organization', name: 'Epicworks s.r.o.' }, publisher: { '@type': 'Organization', name: 'Epicworks s.r.o.' },
};
---
<Base
  title={`${a.headline} | EpicScan research`}
  description={a.summary}
  path={`/research/${a.slug}`}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container narrow hero-inner" style="gap: 20px;">
      <span class="eyebrow" style="color: var(--teal);">Benchmark report · {a.app} · <time datetime={a.published}>{label(a.published)}</time></span>
      <h1 class="h1">{a.headline}</h1>
      <p class="lead">{a.summary}</p>
    </div>
  </section>

  <section class="section" style="padding-top: 24px;">
    <article class="container prose">
      <div class="scroll-x">
        <table class="table">
          <tbody>
            <tr><th scope="row">Bug found (vulnerable file)</th><td><strong>{found} of 3 runs</strong></td></tr>
            <tr><th scope="row">Patched file clean of the bug</th><td><strong>3 of 3 runs</strong></td></tr>
            <tr><th scope="row">False or unrelated findings removed by Opus</th><td>{rejected} rejected; {confirmedOther} unrelated kept (unverified)</td></tr>
            <tr><th scope="row">Local scan time, 6 runs</th><td>{a.scanMinutes} minutes on one Mac Studio</td></tr>
            <tr><th scope="row">Opus cost, 6 runs</th><td>USD {a.opusUsd.toFixed(2)} (both passes)</td></tr>
          </tbody>
        </table>
      </div>

      <h2>The bug</h2>
      <p><a href={`https://nvd.nist.gov/vuln/detail/${a.cve}`} rel="noopener">{a.cve}</a> in {a.app}, one of the vulnerabilities AISLE Research discovered and disclosed. {a.bug}</p>
      <ul>
        <li><strong>Class:</strong> {a.bugClass}</li>
        <li><strong>File:</strong> <code>{a.file}</code>, {a.lines.toLocaleString('en-US')} lines</li>
        <li><strong>Vulnerable:</strong> <a href={a.commitUrl(a.vulnCommit)} rel="noopener"><code>{a.vulnCommit}</code></a>; <strong>fix:</strong> <a href={a.commitUrl(a.fixCommit)} rel="noopener"><code>{a.fixCommit}</code></a></li>
      </ul>

      <h2>What happened</h2>
      {a.story.map((p) => <p>{p}</p>)}

      <h2>Run by run</h2>
      <p>"Raised" are findings the local scan sent to triage, "kept" are the ones local triage believed. Opus then checked every kept finding.</p>
      <div class="scroll-x">
        <table class="table">
          <thead><tr><th scope="col">Run</th><th scope="col">Vulnerable file</th><th scope="col">Patched file</th></tr></thead>
          <tbody>
            {a.vulnerable.map((r, i) => (
              <tr>
                <td>{i + 1}</td>
                <td>{r.found ? <strong>Found. </strong> : 'Missed. '}{cell(r)}</td>
                <td>{cell(a.patched[i])}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted">Kept by local triage: {keptV} on the vulnerable file and {keptP} on the patched file over three runs. In a second pass Opus also checked every finding the local triage rejected; it recovered none of the missed bugs.</p>

      <h2>Takeaway</h2>
      <p>{a.takeaway}</p>

      <h2>How we ran it</h2>
      <p>Same setup as our <a href="/research/local-qwen-opus-validation">first benchmark</a>: nano-analyzer with Qwen 3.6 35B A3B running locally on our Mac Studio, 5 triage rounds, three runs per file, then Claude Opus 4.6 as an optional paid second opinion on public code only. The model is never told which bug to expect. Results for all nine applications: <a href="/research/wider-benchmark-9-cves">the overview</a>.</p>
      <p class="muted">Questions or raw run data: <a href="mailto:scan@epicworks.cz">scan@epicworks.cz</a>.</p>
      <p><a class="btn btn-primary" href="/early-access">Request early access</a></p>
    </article>
  </section>
</Base>
